{
  "listeners": {
    "*:8000": {
      "pass": "routes"
    }
  },
  "routes": [
    {
      "match": {
        "uri": ["/favicon.ico", "/robots.txt"]
      },
      "action": {
        "share": "/var/www/html/public"
      }
    },
    {
      "match": {
        "uri": "/assets/*"
      },
      "action": {
        "share": "/var/www/html/public"
      }
    },
    {
      "action": {
        "pass": "applications/laravel"
      }
    }
  ],
  "applications": {
    "laravel": {
      "type": "php",
      "root": "/var/www/html/public",
      "index": "index.php"
    }
  }
}
